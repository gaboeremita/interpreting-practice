# Port the API listens on.
PORT=4004
# MongoDB connection string. docker compose provides one at mongodb://mongo:27017/isa-drill-room.
MONGODB_URI=mongodb://localhost:27017/isa-drill-room
# Comma-separated origins allowed to call the API. Leave empty when the API serves the built client itself.
CORS_ORIGINS=http://localhost:5173
# Base URL of a Piper server (python -m piper.http_server) for natural voices. Leave empty to use only browser voices.
PIPER_TTS_URL=http://localhost:5050
